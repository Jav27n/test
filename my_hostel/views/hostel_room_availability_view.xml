<odoo>
    <data>
        <record id="action_hostel_room_availability" model="ir.actions.act_window">
            <field name="name">Room Availability</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hostel.room.availability</field>
            <field name="view_mode">pivot</field>
        </record>

         <menuitem id="hostel_room_availability_menu" name="Room Availability" parent="my_hostel.hostel_main_menu"
              action="my_hostel.action_hostel_room_availability" sequence="20"/>

        <record id="hostel_room_availability_pivot_view" model="ir.ui.view">
            <field name="name">hostel.room.availability.pivot.view</field>
            <field name="model">hostel.room.availability</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="room_id" type="row"/>
                    <field name="student_per_room" type="measure"/>
                    <field name="availability" type="measure"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

    </data>
</odoo>