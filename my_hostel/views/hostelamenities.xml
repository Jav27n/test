<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_hostel_amenities" model="ir.actions.act_window">
        <field name="name">Hostel Amenities</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hostel.amenities</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create Hostel amenity.
            </p>
        </field>
    </record>

<!--    <menuitem id="hostel_amenity_main_menu" name="Hostel Amenities" sequence="10"/>-->

    <menuitem id="hostel_amenity_sub_menu" name="Hostel Amenities" parent="my_hostel.hostel_main_menu"
              action="my_hostel.action_hostel_amenities" groups="my_hostel.group_hostel_manager"
              sequence="11"/>

    <record id="view_hostel_amenities_form_view" model="ir.ui.view">
        <field name="name">hostel.amenities.form.view</field>
        <field name="model">hostel.amenities</field>
        <field name="arch" type="xml">
            <form string="Hostel Amenities">
                <sheet>
                    <h3>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </h3>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hostel_amenities_list_view" model="ir.ui.view">
        <field name="name">hostel.amenities.list.view</field>
        <field name="model">hostel.amenities</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

</odoo>