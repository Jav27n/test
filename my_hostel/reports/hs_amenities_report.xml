<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_hostel_amenities_detail" model="ir.actions.report">
        <field name="name">hostel amenities detail report</field>
        <field name="model">hostel.amenities</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_hostel_amenities"/>
        <field name="report_name">my_hostel.hostel_amenities_detail_reports_template</field>
        <field name="report_file">my_hostel.hostel_amenities_detail_reports_template</field>
    </record>

    <template id="hostel_amenities_detail_reports_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <div class="page">

                            <div t-esc="doc.get_amenity_status()"/>

                    </div>

                </t>
            </t>
        </t>

    </template>

</odoo>

