<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_hostel_room_category" model="ir.actions.act_window">
        <field name="name">Hostel Room Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hostel.room.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create Hostel Room Category.
            </p>
        </field>
    </record>

    <menuitem id="hostel_room_category_sub_menu" name="Hostel Room Categories" parent="my_hostel.hostel_main_menu"
              action="my_hostel.action_hostel_room_category" groups="my_hostel.group_hostel_manager"
              sequence="15"/>

    <record id="view_hostel_room_category_form_view" model="ir.ui.view">
        <field name="name">hostel.room.category.form.view</field>
        <field name="model">hostel.room.category</field>
        <field name="arch" type="xml">
            <form string="Hostel Room Category">
                <sheet>

                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                    </group>

                    <group>
                        <button name="create_categories" string="Create Categories" type="object"/>
                    </group>

                    <notebook>
                        <page string="Child Categories">
                            <field name="child_ids">
                                <list string="Child Categories">
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hostel_room_category_list_view" model="ir.ui.view">
        <field name="name">hostel.room.category.list.view</field>
        <field name="model">hostel.room.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

</odoo>