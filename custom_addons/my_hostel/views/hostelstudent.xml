<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_hostel_student" model="ir.actions.act_window">
        <field name="name">Hostel Student</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hostel.student</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create Hostel Student.
            </p>
        </field>
    </record>

<!--    <menuitem id="hostel_student_main_menu" name="Hostel Student" sequence="4"/>-->

    <menuitem id="hostel_student_sub_menu" name="Hostel Student" parent="my_hostel.hostel_main_menu"
              action="my_hostel.action_hostel_student" groups="my_hostel.group_hostel_manager"
              sequence="1"/>

    <record id="view_hostel_student_form_view" model="ir.ui.view">
        <field name="name">hostel.student.form.view</field>
        <field name="model">hostel.student</field>
        <field name="arch" type="xml">
            <form string="Hostel Student">
                <sheet>
                    <h3>
                        <group>

                            <group>
                                <field name="name"/>
                                <field name="gender"/>
                                <field name="active"/>
                            </group>

                            <group>
                                <field name="admission_date"/>
                                <field name="discharge_date"/>
                                <field name="duration"/>
                            </group>

                            <group>
                                <field name="room_id"/>
<!--                                <field name="contact_address"/>-->
                                <field name="hostel_id"/>
                            </group>

                        </group>
                    </h3>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hostel_student_list_view" model="ir.ui.view">
        <field name="name">hostel.student.list.view</field>
        <field name="model">hostel.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

</odoo>